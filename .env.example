MYSQL_IMAGE=mysql:5.7
MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_USER=susu
MYSQL_DATABASE=embyboss
MYSQL_PASSWORD=replace-with-a-long-database-password

# Optional USDT networks: Binance read-only API keys; never enable withdrawals.
TGBOT_POLYGON_RPC_URL=
TGBOT_BINANCE_API_KEY=
TGBOT_BINANCE_API_SECRET=
TGBOT_BSC_RPC_URL=
TGBOT_TONCENTER_API_KEY=

# Optional private danmu_api adapter; leave both empty to disable.
# Same host as this host-network Bot: http://127.0.0.1:9321
# Token: 32-256 characters from A-Z, a-z, 0-9, underscore or hyphen.
TGBOT_DANMU_API_URL=
TGBOT_DANMU_API_TOKEN=
