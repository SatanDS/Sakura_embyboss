{
	# TLS is terminated by the frontend proxy.
	auto_https off
}

(playlist_ban) {
	reverse_proxy {args[0]} {
		method GET
		rewrite /emby/ban_playlist?
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up -X-DuSheng-Origin-Token
		header_up X-DuSheng-Line-Token {$DUSHENGCDN_ORIGIN_TOKEN}
		header_up X-Original-URI {http.request.orig_uri}
		header_up X-Original-Method {http.request.orig_method}
	}
}

(emby_local_config) {
	http://{args[0]}:{args[2]} {
		# Access/debug logs are disabled: Emby URLs and headers carry credentials.

		# DuShengCDN does not have a stable source IP. Require its private
		# shared origin token before accepting any request on public 18080.
		# The value is injected at runtime; never commit it.
		@origin_invalid {
			not header X-DuSheng-Origin-Token {$DUSHENGCDN_ORIGIN_TOKEN}
		}
		@emby_response_no_store path_regexp emby_response_no_store (?i)^/(?:emby/)?(?:Videos|Audio|Items|PlaybackInfo|MediaSegments|LiveTv|Sessions)(?:/|$)

		# 播放线路审查：
		# Emby Web 常见上报路径是 /emby/Sessions/Playing/Progress。
		# 这里只要命中 /emby/Sessions/Playing 开头的请求，都会先走 line_report，再反代到 Emby。
		@line_audit_play path_regexp line_audit_play (?i)^/(?:emby/)?Sessions/Playing(?:/|$)

		# A Playing/Progress report can arrive after the media connection has
		# already been opened. Audit the actual media endpoints as well so a
		# denied VIP request cannot keep receiving video/audio or HLS segments.
		@line_audit_media path_regexp line_audit_media (?i)^/(?:emby/)?(?:(?:Videos|Audio)/|(?:Items/[^/]+/)?PlaybackInfo(?:/|$)|MediaSegments(?:/|$)|LiveTv/(?:LiveStreams|LiveStreamFiles|LiveRecordings)(?:/|$))
		@line_audit_download path_regexp line_audit_download (?i)^/(?:emby/)?Items/[^/]+/(Download|File)(/|$)

		# Playlist mutations are authenticated and processed by the local Bot.
		@playlist_create {
			method POST
			path /emby/Playlists
		}

		# 添加条目到播放列表。
		@playlist_items_post {
			method POST
			path_regexp playlist_items_post ^/emby/Playlists/[^/]+/Items$
		}

		# 删除播放列表中的条目。
		@playlist_item_delete {
			method DELETE
			path_regexp playlist_item_delete ^/emby/Playlists/[^/]+/Items/[^/]+$
		}

		# 移动播放列表条目。
		@playlist_item_move {
			method POST
			path_regexp playlist_item_move ^/emby/Playlists/[^/]+/Items/[^/]+/Move/[^/]+$
		}

		# 读取播放列表条目时直接返回空列表，避免前端继续展示。
		@playlist_items_get {
			method GET
			path_regexp playlist_items_get ^/emby/Playlists/[^/]+/Items$
		}

		route {
			handle @origin_invalid {
				respond "Forbidden" 403
			}
			header @emby_response_no_store Cache-Control "private, no-store"

			handle @playlist_create {
				import playlist_ban {args[4]}
			}

			handle @playlist_items_post {
				import playlist_ban {args[4]}
			}

			handle @playlist_item_delete {
				import playlist_ban {args[4]}
			}

			handle @playlist_item_move {
				import playlist_ban {args[4]}
			}

			handle @playlist_items_get {
				header Content-Type application/json
				respond `{"Items":[],"TotalRecordCount":0}` 200
			}

			handle @line_audit_play {
				# forward_auth 在这里相当于“同步上报”：
				# 先把原始请求地址和认证头转给 bot 的 /emby/line_report，
				# 再继续反代到 Emby。
				forward_auth {args[4]} {
					uri /emby/line_report?line={args[1]}&host={args[0]}
					# The auth endpoint is local. Keep client forwarding headers out of
					# this subrequest; Uvicorn accepts only the real socket peer.
					header_up -X-Forwarded-For
					header_up -X-Real-IP
					header_up -X-DuSheng-Origin-Token
					header_up X-DuSheng-Line-Token {$DUSHENGCDN_ORIGIN_TOKEN}
					header_up X-Original-URI {uri}
					header_up X-Emby-Authorization {header.X-Emby-Authorization}
					header_up X-Emby-Token {header.X-Emby-Token}
					header_up Authorization {header.Authorization}
				}
				reverse_proxy {args[3]} {
					header_up -X-DuSheng-Origin-Token
					header_up -X-DuSheng-Line-Token
				}
			}

			handle @line_audit_media {
				# Keep the same synchronous authorization on stream and HLS
				# requests; forward_auth returns 403 for a blocked line.
				forward_auth {args[4]} {
					uri /emby/line_report?line={args[1]}&host={args[0]}
					header_up -X-Forwarded-For
					header_up -X-Real-IP
					header_up -X-DuSheng-Origin-Token
					header_up X-DuSheng-Line-Token {$DUSHENGCDN_ORIGIN_TOKEN}
					header_up X-Original-URI {uri}
					header_up X-Emby-Authorization {header.X-Emby-Authorization}
					header_up X-Emby-Token {header.X-Emby-Token}
					header_up Authorization {header.Authorization}
				}
				reverse_proxy {args[3]} {
					header_up -X-DuSheng-Origin-Token
					header_up -X-DuSheng-Line-Token
				}
			}

			handle @line_audit_download {
				# Downloads are media transfers too and must follow the same rule.
				forward_auth {args[4]} {
					uri /emby/line_report?line={args[1]}&host={args[0]}
					header_up -X-Forwarded-For
					header_up -X-Real-IP
					header_up -X-DuSheng-Origin-Token
					header_up X-DuSheng-Line-Token {$DUSHENGCDN_ORIGIN_TOKEN}
					header_up X-Original-URI {uri}
					header_up X-Emby-Authorization {header.X-Emby-Authorization}
					header_up X-Emby-Token {header.X-Emby-Token}
					header_up Authorization {header.Authorization}
				}
				reverse_proxy {args[3]} {
					header_up -X-DuSheng-Origin-Token
					header_up -X-DuSheng-Line-Token
				}
			}

			# 其余请求正常反代给 Emby。
			handle {
				reverse_proxy {args[3]} {
					header_up -X-DuSheng-Origin-Token
					header_up -X-DuSheng-Line-Token
				}
			}
		}
	}
}
# 用户只需要修改这一行参数
# 参数1. server_name   访问域名，例如 vip.embyline.com
# 参数2. line_name     上报给 bot 的线路名，例如 vipline
# 参数3. caddy_port    Caddy 监听端口，例如 8080
# 参数4. emby_upstream Emby 地址，例如 127.0.0.1:8096
# 参数5. bot_upstream  Bot API 地址，例如 127.0.0.1:8838
import emby_local_config localhost vipline 8080 127.0.0.1:8096 127.0.0.1:8838
