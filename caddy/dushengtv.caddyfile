# Dedicated public TV hostname. Standard Caddy terminates TLS on 443.
# Import this file from a Caddy configuration that already owns ports 80/443.
tv-api.dusheng.lol {
    @tv path /api/dushengtv/v1/*
    handle @tv {
        reverse_proxy 127.0.0.1:8840
    }
    handle {
        respond "Not Found" 404
    }
}

# LiveKit signaling uses this HTTPS/WSS endpoint. WebRTC media and TURN ports
# connect directly to the LiveKit host and must not be placed behind a normal
# HTTP-only CDN proxy.
voice-api.dusheng.lol {
    reverse_proxy 127.0.0.1:7880
}
